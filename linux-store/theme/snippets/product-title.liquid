{%- comment -%}
  Product title with word-level Arabic fallback. If the merchant translated the
  product in Shopify (Translate & Adapt) the title already arrives localized
  and contains Arabic, so it is shown as-is. Otherwise, in Arabic, each word is
  looked up in products.option_values (hoodie → هودي, black → أسود …) and
  unknown words stay as they are.
  Usage: {% render 'product-title', title: product.title %}
{%- endcomment -%}
{%- if request.locale.iso_code == 'ar' -%}
  {%- assign words = title | split: ' ' -%}
  {%- capture out -%}
    {%- for w in words -%}
      {%- assign k = w | downcase | strip | replace: '-', '_' -%}
      {%- assign key = 'products.option_values.' | append: k -%}
      {%- assign tr = key | t -%}
      {%- if tr contains 'translation missing' -%}{{ w }}{%- else -%}{{ tr }}{%- endif -%}
      {%- unless forloop.last %} {% endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  {{- out | strip -}}
{%- else -%}
  {{- title -}}
{%- endif -%}
