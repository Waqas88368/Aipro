{%- if cart.item_count > 0 -%}
  <details class="cart-note">
    <summary>{{ 'cart.add_note' | t }} {% render 'icon', name: 'chevron-down', px: 14 %}</summary>
    <textarea class="textarea" name="note" data-cart-note placeholder="{{ 'cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
  </details>
  <div class="cart-discount" data-cart-discount>
    <label class="cart-discount__row">
      <span class="visually-hidden">{{ 'cart.discount_code' | t }}</span>
      {% render 'icon', name: 'tag', px: 16 %}
      <input class="input" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="{{ 'cart.discount_placeholder' | t }}" data-discount-input>
      <button class="btn btn--glass btn--sm" type="button" data-discount-apply>{{ 'cart.apply_discount' | t }}</button>
    </label>
    <div class="cart-discount__codes" data-discount-codes>
      {%- for code in cart.discount_codes -%}
        <span class="chip chip--code{% unless code.applicable %} is-invalid{% endunless %}">{% render 'icon', name: 'tag', px: 12 %}{{ code.code }}<button type="button" data-discount-remove="{{ code.code | escape }}" aria-label="{{ 'cart.remove' | t }}">{% render 'icon', name: 'close', px: 12 %}</button></span>
      {%- endfor -%}
    </div>
    <p class="form-error" data-discount-error hidden></p>
  </div>
  <div class="cart-totals">
    {%- if cart.total_discount > 0 -%}
      <div class="cart-totals__row"><span>{{ 'cart.discount' | t }}</span><span>−{{ cart.total_discount | money }}</span></div>
    {%- endif -%}
    <div class="cart-totals__row cart-totals__row--total"><span>{{ 'cart.subtotal' | t }}</span><span class="money" data-cart-total>{{ cart.total_price | money }}</span></div>
    <p class="small muted">{{ 'cart.shipping_note' | t }}</p>
  </div>
  <form action="{{ routes.cart_url }}" method="post" class="cart-actions" style="display:grid;gap:10px">
    <button class="btn btn--primary btn--lg btn--block" type="submit" name="checkout">{% render 'icon', name: 'lock', px: 18 %}{{ 'cart.checkout' | t }}</button>
    {%- if context == 'drawer' and settings.cart_type == 'drawer' -%}
      <a href="{{ routes.cart_url }}" class="btn btn--ghost btn--sm btn--block">{{ 'cart.view_bag' | t }}</a>
    {%- endif -%}
  </form>
  <div class="payment-icons">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}</div>
{%- endif -%}
