<div class="modal" id="quick-view" data-modal="quick-view" role="dialog" aria-modal="true" aria-label="{{ 'products.quick_view' | t }}" aria-hidden="true" inert>
  <div class="modal__panel glass glass--solid" data-quick-view-panel>
    <button class="icon-btn glass glass--clear modal__close" type="button" data-modal-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    <div data-quick-view-content></div>
  </div>
</div>
