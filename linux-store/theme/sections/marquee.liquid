{%- if section.blocks.size > 0 -%}
<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {%- for i in (1..3) -%}
      {%- for block in section.blocks -%}
        <span class="marquee__item" {{ block.shopify_attributes }}>{{ block.settings.text }}{% render 'icon', name: 'sparkle', px: 16 %}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Marquee",
  "blocks": [ { "type": "item", "name": "Item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Embroidered in Cairo" } ] } ],
  "presets": [ { "name": "Marquee", "blocks": [ { "type": "item", "settings": { "text": "Free shipping over LE 2,000" } }, { "type": "item", "settings": { "text": "Embroidered, not printed" } }, { "type": "item", "settings": { "text": "14-day easy exchange" } }, { "type": "item", "settings": { "text": "Heavyweight 340gsm melton" } }, { "type": "item", "settings": { "text": "Cash on delivery" } } ] } ]
}
{% endschema %}
