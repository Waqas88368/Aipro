{%- assign s = section.settings -%}
<section class="section wrap" id="s-{{ section.id }}">
  <div class="campaign glass{% if s.flip %} campaign--flip{% endif %}" data-specular data-reveal>
    <div class="campaign__media media media__zoom">
      {%- if s.image != blank -%}
        <img src="{{ s.image | image_url: width: 1200 }}" alt="{{ s.heading | escape }}" width="1200" height="1500" loading="lazy">
      {%- else -%}
        <img src="{{ 'brand-lookbook-2.webp' | asset_url }}" alt="" width="1000" height="1334" loading="lazy">
      {%- endif -%}
    </div>
    <div class="campaign__body">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="display" style="font-size:clamp(34px,4.4vw,64px)">{{ s.heading }}</h2>
      {%- if s.body != blank -%}<p class="lede">{{ s.body }}</p>{%- endif -%}
      <div class="campaign__cta">
        {%- if s.primary_label != blank -%}<a href="{{ s.primary_link | default: routes.all_products_collection_url }}" class="btn btn--primary" data-magnetic>{{ s.primary_label }}{% render 'icon', name: 'arrow-right' %}</a>{%- endif -%}
        {%- if s.secondary_label != blank -%}<a href="{{ s.secondary_link | default: routes.all_products_collection_url }}" class="btn btn--glass">{{ s.secondary_label }}</a>{%- endif -%}
      </div>
      {%- if s.note != blank -%}<p class="mono muted">{{ s.note }}</p>{%- endif -%}
    </div>
    {%- if s.show_mascot -%}<div class="campaign__mascot" aria-hidden="true">{% render 'mascot', name: s.mascot, width: 170 %}</div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Campaign",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "flip", "label": "Image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Green is the new black." },
    { "type": "textarea", "id": "body", "label": "Text", "default": "Forest heavyweight fleece, cream embroidery, rounded everything. Built for Cairo nights." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Shop hoodies" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Customize yours" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "note", "label": "Note", "default": "LIMITED RUN · FW26" },
    { "type": "checkbox", "id": "show_mascot", "label": "Show penguin", "default": true },
    { "type": "select", "id": "mascot", "label": "Penguin", "options": [ { "value": "boombox", "label": "Boombox" }, { "value": "skate", "label": "Skate" }, { "value": "classic", "label": "Classic" }, { "value": "hoodie-sit", "label": "Hoodie" }, { "value": "astro", "label": "Astronaut" } ], "default": "boombox" }
  ],
  "presets": [ { "name": "Campaign" } ]
}
{% endschema %}
