{%- liquid
  assign s = section.settings
  assign current = product.selected_or_first_available_variant
  assign media_count = product.media.size
  assign size_option = null
  for opt in product.options_with_values
    assign lower = opt.name | downcase
    if lower == 'size' or lower == 'sizes' or lower == 'المقاس' or lower == 'مقاس'
      assign size_option = opt
    endif
  endfor
  assign form_image = current.featured_image | default: product.featured_image | image_url: width: 200
-%}
<section class="pdp wrap" id="pdp-{{ section.id }}" data-product data-product-handle="{{ product.handle }}" data-section-id="{{ section.id }}">
  {%- if s.show_breadcrumb -%}
    <nav class="crumbs pdp__crumbs" aria-label="{{ 'general.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'nav.home' | t }}</a>{% render 'icon', name: 'chevron-right', px: 12 %}
      {%- if collection -%}<a href="{{ collection.url }}">{% render 'menu-title', title: collection.title %}</a>{% render 'icon', name: 'chevron-right', px: 12 %}{%- endif -%}
      <span aria-current="page">{% render 'product-title', title: product.title %}</span>
    </nav>
  {%- endif -%}

  <div class="pdp__grid">
    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="pdp__gallery" data-gallery>
      <div class="gallery__main glass" data-gallery-main>
        <div class="gallery__track" data-gallery-track role="region" aria-label="{{ 'products.media_gallery' | t }}">
          {%- for media in product.media -%}
            <figure class="gallery__slide" data-gallery-slide data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}">
              {%- if media.media_type == 'image' -%}
                <img src="{{ media | image_url: width: 1200 }}" srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1800 }} 1800w" sizes="(max-width: 900px) 100vw, 55vw" alt="{{ media.alt | default: product.title | escape }}" width="1200" height="{{ 1200 | divided_by: media.aspect_ratio | round }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async" data-zoom-src="{{ media | image_url: width: 2400 }}">
              {%- elsif media.media_type == 'video' -%}
                {{ media | video_tag: controls: true, muted: true, loop: true, playsinline: true, class: 'gallery__video' }}
              {%- else -%}
                {{ media | media_tag }}
              {%- endif -%}
            </figure>
          {%- else -%}
            <figure class="gallery__slide">{{ 'product-1' | placeholder_svg_tag }}</figure>
          {%- endfor -%}
        </div>
        <div class="gallery__badges">
          {%- if current.compare_at_price > current.price -%}<span class="chip chip--sale" data-badge-sale>{{ 'products.sale' | t }}</span>{%- endif -%}
          <span class="chip chip--onmedia">{% render 'icon', name: 'needle', px: 12 %}{{ 'products.embroidered' | t }}</span>
        </div>
        <button class="icon-btn glass glass--clear gallery__zoom" type="button" data-gallery-zoom aria-label="{{ 'products.zoom' | t }}">{% render 'icon', name: 'zoom', px: 18 %}</button>
        {%- if media_count > 1 -%}
          <button class="icon-btn glass glass--clear gallery__nav gallery__nav--prev" type="button" data-gallery-prev aria-label="{{ 'accessibility.previous' | t }}">{% render 'icon', name: 'arrow-left', px: 18 %}</button>
          <button class="icon-btn glass glass--clear gallery__nav gallery__nav--next" type="button" data-gallery-next aria-label="{{ 'accessibility.next' | t }}">{% render 'icon', name: 'arrow-right', px: 18 %}</button>
          <div class="gallery__dots" data-gallery-dots>{%- for media in product.media -%}<span class="gallery__dot{% if forloop.first %} is-active{% endif %}"></span>{%- endfor -%}</div>
        {%- endif -%}
      </div>
      {%- if media_count > 1 -%}
        <div class="gallery__thumbs" data-gallery-thumbs>
          {%- for media in product.media -%}
            <button class="gallery__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-gallery-thumb="{{ forloop.index0 }}" aria-label="{{ 'accessibility.image_of' | t: index: forloop.index, total: media_count }}">
              <img src="{{ media.preview_image | image_url: width: 160 }}" alt="" width="72" height="90" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Buy box ---------- {%- endcomment -%}
    <div class="pdp__info">
      <div class="pdp__panel glass" data-specular>
        <div class="pdp__head">
          <p class="card__meta">{{ product.vendor }} · {% render 'option-value', value: product.type %}</p>
          <h1 class="pdp__title">{% render 'product-title', title: product.title %}</h1>
          <div class="pdp__price-row">
            <div class="pdp__price" data-price-wrap>{% render 'price', variant: current, product: product, class: 'price--lg' %}</div>
            {%- if s.show_rating -%}<span class="pdp__rating">{% render 'icon', name: 'star', px: 14 %} {{ s.rating_text }}</span>{%- endif -%}
          </div>
        </div>

        {%- form 'product', product, id: 'product-form', class: 'pdp__form', data-product-form: '', data-image: form_image -%}
          <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- liquid
                assign lower = option.name | downcase
                assign is_color = false
                if lower == 'color' or lower == 'colour' or lower == 'اللون'
                  assign is_color = true
                endif
                assign is_size = false
                if lower == 'size' or lower == 'sizes' or lower == 'المقاس' or lower == 'مقاس'
                  assign is_size = true
                endif
              -%}
              <fieldset class="pdp__option" data-option-index="{{ forloop.index0 }}">
                <legend class="pdp__option-label">
                  <span>{% render 'option-name', name: option.name %}</span>
                  <strong data-option-value="{{ forloop.index0 }}">{% render 'option-value', value: option.selected_value %}</strong>
                  {%- if is_size and settings.show_size_guide -%}
                    <button class="pdp__size-guide" type="button" data-drawer-open="size-guide">{% render 'icon', name: 'ruler', px: 14 %}{{ 'products.size_guide' | t }}</button>
                  {%- endif -%}
                </legend>
                <div class="pills">
                  {%- for value in option.values -%}
                    <label class="pill{% if is_color %} swatch pill--swatch{% endif %}" {% if is_color %}style="--swatch: {% render 'swatch-color', value: value %}"{% endif %} title="{{ value | escape }}">
                      <input type="radio" name="option{{ option.position }}" value="{{ value | escape }}" data-option-input="{{ option.position | minus: 1 }}" {% if option.selected_value == value %}checked{% endif %}>
                      {%- unless is_color -%}{% render 'option-value', value: value %}{%- else -%}<span class="visually-hidden">{% render 'option-value', value: value %}</span>{%- endunless -%}
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
            {%- if size_option -%}<p class="small muted pdp__fit">{% render 'icon', name: 'sparkle', px: 14 %} {{ 'products.true_to_size' | t }}</p>{%- endif -%}
          {%- endunless -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'fit_finder' -%}{%- if size_option -%}{% render 'fit-finder', block: block, product: product, size_option: size_option %}{%- endif -%}
              {%- when 'bundle' -%}{% render 'bundle-offer', block: block, product: product, current: current %}
            {%- endcase -%}
          {%- endfor -%}

          <div class="pdp__stock" data-stock>
            {%- if current.available -%}
              {%- if settings.show_stock_hint and current.inventory_management == 'shopify' and current.inventory_quantity > 0 and current.inventory_quantity <= settings.low_stock -%}
                <span class="dot dot--warn"></span>{{ 'products.low_stock' | t: count: current.inventory_quantity }}
              {%- else -%}
                <span class="dot"></span>{{ 'products.in_stock' | t }}
              {%- endif -%}
            {%- else -%}
              <span class="dot dot--off"></span>{{ 'products.sold_out' | t }}
            {%- endif -%}
          </div>

          <div class="pdp__buy">
            <div class="qty">
              <button class="qty__btn" type="button" data-qty-step="-1" aria-label="{{ 'cart.decrease' | t }}">−</button>
              <input class="qty__input" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'products.quantity' | t }}">
              <button class="qty__btn" type="button" data-qty-step="1" aria-label="{{ 'cart.increase' | t }}">+</button>
            </div>
            <button class="btn btn--primary btn--lg pdp__atc" type="submit" data-atc {% unless current.available %}disabled{% endunless %}>
              <span data-atc-text>{% if current.available %}{{ 'products.add_to_bag' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
              <span class="pdp__atc-price" data-atc-price>{{ current.price | money }}</span>
            </button>
            <button class="icon-btn glass pdp__wish" type="button" data-wishlist-toggle="{{ product.handle }}" aria-label="{{ 'wishlist.add' | t }}" aria-pressed="false">{% render 'icon', name: 'heart' %}{% render 'icon', name: 'heart-fill' %}</button>
          </div>
          {%- if settings.whatsapp_number != blank -%}
            <a class="btn btn--glass btn--block pdp__wa" href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}?text={{ 'general.whatsapp_prefill' | t | append: ' ' | append: product.title | url_encode }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp', px: 18 %}{{ 'general.whatsapp' | t }}</a>
          {%- endif -%}
        {%- endform -%}

        {%- if settings.show_delivery_estimate -%}
          <div class="pdp__delivery">
            <div>{% render 'icon', name: 'truck', px: 18 %}<span><strong>{{ 'products.delivery_cairo' | t }}</strong> {{ settings.delivery_cairo }}</span></div>
            <div>{% render 'icon', name: 'pin', px: 18 %}<span><strong>{{ 'products.delivery_egypt' | t }}</strong> {{ settings.delivery_egypt }}</span></div>
            {%- if settings.free_shipping_threshold > 0 -%}{%- assign fs_amount = settings.free_shipping_threshold | times: 100 | money -%}<div>{% render 'icon', name: 'return', px: 18 %}<span>{{ 'products.free_shipping_over' | t: amount: fs_amount }}</span></div>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pdp__details">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'description' -%}
              <details class="faq__item glass" open {{ block.shopify_attributes }}>
                <summary>{%- assign t_d = 'products.description' | t -%}{{ block.settings.title | default: t_d }}{% render 'icon', name: 'plus', px: 18 %}</summary>
                <div class="rte">{{ product.description }}</div>
              </details>
            {%- when 'fabric' -%}
              <details class="faq__item glass" {{ block.shopify_attributes }}>
                <summary>{%- assign t_f = 'products.fabric' | t -%}{{ block.settings.title | default: t_f }}{% render 'icon', name: 'plus', px: 18 %}</summary>
                <div class="rte">{%- assign t_fb = 'products.fabric_body' | t -%}{{ block.settings.content | default: t_fb }}</div>
              </details>
            {%- when 'shipping' -%}
              <details class="faq__item glass" {{ block.shopify_attributes }}>
                <summary>{%- assign t_s = 'products.shipping' | t -%}{{ block.settings.title | default: t_s }}{% render 'icon', name: 'plus', px: 18 %}</summary>
                <div class="rte">{%- assign t_sb = 'products.shipping_body' | t -%}{{ block.settings.content | default: t_sb }}</div>
              </details>
            {%- when 'custom' -%}
              <details class="faq__item glass" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.title }}{% render 'icon', name: 'plus', px: 18 %}</summary>
                <div class="rte">{{ block.settings.content }}</div>
              </details>
          {%- endcase -%}
        {%- endfor -%}
        <div class="pdp__share">
          <button class="btn btn--ghost btn--sm" type="button" data-copy="{{ shop.url }}{{ product.url }}" data-share>{% render 'icon', name: 'share', px: 16 %}{{ 'products.share' | t }}</button>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ---------- Variant data for product.js ---------- {%- endcomment -%}
  <script type="application/json" data-option-labels>{ {%- for option in product.options_with_values -%}{%- for value in option.values -%}{%- capture lv -%}{% render 'option-value', value: value %}{%- endcapture -%}{{ value | json }}: {{ lv | strip | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }</script>
  <script type="application/json" data-variants>{{ product.variants | json }}</script>
  <script type="application/json" data-product-json>{"id":{{ product.id }},"handle":{{ product.handle | json }},"title":{{ product.title | json }},"url":{{ product.url | json }},"image":{{ product.featured_image | image_url: width: 400 | json }},"price":{{ product.price }},"type":{{ product.type | json }},"lowStock":{{ settings.low_stock | default: 5 }},"strings":{"lowStock":{{ 'products.low_stock' | t: count: '[count]' | json }},"inStock":{{ 'products.in_stock' | t | json }},"soldOut":{{ 'products.sold_out' | t | json }},"unavailable":{{ 'products.unavailable' | t | json }},"addToBag":{{ 'products.add_to_bag' | t | json }}}}</script>
</section>

{%- if settings.show_sticky_atc -%}
  <div class="sticky-atc glass glass--solid" data-sticky-atc aria-hidden="true">
    <img src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="44" height="54">
    <div class="sticky-atc__text"><strong>{% render 'product-title', title: product.title %}</strong><span data-sticky-price>{{ current.price | money }}</span></div>
    <button class="btn btn--primary" type="button" data-sticky-submit>{{ 'products.add_to_bag' | t }}</button>
  </div>
{%- endif -%}

{%- if settings.show_size_guide -%}
  {% render 'size-guide-drawer', product: product %}
{%- endif -%}

<div class="lightbox" data-lightbox aria-hidden="true" inert>
  <button class="icon-btn glass glass--clear lightbox__close" type="button" data-lightbox-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
  <img class="lightbox__img" src="{{ 'hero-embroidery-poster.webp' | asset_url }}" alt="" width="1600" height="1600" data-lightbox-img>
</div>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating chip", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9 · 120 reviews" }
  ],
  "blocks": [
    { "type": "description", "name": "Description", "limit": 1, "settings": [ { "type": "text", "id": "title", "label": "Title" } ] },
    { "type": "fabric", "name": "Fabric & care", "limit": 1, "settings": [ { "type": "text", "id": "title", "label": "Title" }, { "type": "richtext", "id": "content", "label": "Content" } ] },
    { "type": "shipping", "name": "Shipping & exchange", "limit": 1, "settings": [ { "type": "text", "id": "title", "label": "Title" }, { "type": "richtext", "id": "content", "label": "Content" } ] },
    { "type": "bundle", "name": "Bundle offer (buy more, save more)", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Create matching automatic discounts in Admin → Discounts (e.g. Buy 2 get 10% off). This block only shows the tiers and sets the quantity." },
      { "type": "text", "id": "title", "label": "Title (blank = translated)" },
      { "type": "text", "id": "subtitle", "label": "Subtitle (blank = translated)" },
      { "type": "range", "id": "tier1_qty", "label": "Tier 1 quantity", "min": 2, "max": 6, "step": 1, "default": 2 },
      { "type": "range", "id": "tier1_pct", "label": "Tier 1 discount %", "min": 5, "max": 50, "step": 5, "default": 10 },
      { "type": "range", "id": "tier2_qty", "label": "Tier 2 quantity", "min": 2, "max": 8, "step": 1, "default": 3 },
      { "type": "range", "id": "tier2_pct", "label": "Tier 2 discount %", "min": 5, "max": 50, "step": 5, "default": 15 },
      { "type": "range", "id": "tier3_qty", "label": "Tier 3 quantity (0 = hide)", "min": 0, "max": 10, "step": 1, "default": 0 },
      { "type": "range", "id": "tier3_pct", "label": "Tier 3 discount %", "min": 5, "max": 50, "step": 5, "default": 20 }
    ] },
    { "type": "fit_finder", "name": "Find your size", "limit": 1, "settings": [ { "type": "text", "id": "title", "label": "Title (blank = translated)" } ] },
    { "type": "custom", "name": "Custom accordion", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Details" }, { "type": "richtext", "id": "content", "label": "Content" } ] }
  ]
}
{% endschema %}
