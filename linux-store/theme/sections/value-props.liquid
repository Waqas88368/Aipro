<section class="section wrap" id="s-{{ section.id }}">
  <div class="props">
    {%- for block in section.blocks -%}
      <div class="prop glass glass--hover" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <span class="prop__icon">{% render 'icon', name: block.settings.icon, px: 22 %}</span>
        <strong>{{ block.settings.title }}</strong>
        <span>{{ block.settings.text }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Value props",
  "blocks": [ { "type": "prop", "name": "Prop", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "needle", "label": "Needle" }, { "value": "shield", "label": "Shield" }, { "value": "package", "label": "Package" }, { "value": "whatsapp", "label": "WhatsApp" }, { "value": "sparkle", "label": "Sparkle" } ], "default": "truck" },
    { "type": "text", "id": "title", "label": "Title", "default": "Fast delivery" },
    { "type": "text", "id": "text", "label": "Text", "default": "1–2 days in Cairo, 2–4 across Egypt." }
  ] } ],
  "presets": [ { "name": "Value props", "blocks": [
    { "type": "prop", "settings": { "icon": "truck", "title": "Fast delivery", "text": "1–2 days in Cairo, 2–4 across Egypt." } },
    { "type": "prop", "settings": { "icon": "package", "title": "Cash on delivery", "text": "Pay when it lands. Cards too." } },
    { "type": "prop", "settings": { "icon": "return", "title": "14-day exchange", "text": "Wrong size? Swap it, no drama." } },
    { "type": "prop", "settings": { "icon": "needle", "title": "Embroidered, not printed", "text": "Thread that outlives the trend." } }
  ] } ]
}
{% endschema %}
