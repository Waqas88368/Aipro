{%- assign s = section.settings -%}
<section class="section wrap" id="s-{{ section.id }}">
  <div class="faq">
    <div data-reveal>
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2>{{ s.heading }}</h2>
      {%- if s.body != blank -%}<p class="lede" style="margin-top:14px">{{ s.body }}</p>{%- endif -%}
      {%- if s.cta_label != blank -%}<a href="{{ s.cta_url | default: '/pages/contact' }}" class="btn btn--glass" style="margin-top:22px">{% render 'icon', name: 'whatsapp', px: 18 %}{{ s.cta_label }}</a>{%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item glass"{% if forloop.first and s.open_first %} open{% endif %} data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}{% render 'icon', name: 'plus', px: 18 %}</summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "textarea", "id": "body", "label": "Text", "default": "Delivery, exchanges and sizing in one place." },
    { "type": "checkbox", "id": "open_first", "label": "Open first item", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Ask on WhatsApp" },
    { "type": "url", "id": "cta_url", "label": "Link" }
  ],
  "blocks": [ { "type": "question", "name": "Question", "settings": [
    { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
    { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Cairo &amp; Giza: 1–2 days. Rest of Egypt: 2–4 days.</p>" }
  ] } ],
  "presets": [ { "name": "FAQ", "blocks": [ { "type": "question" }, { "type": "question", "settings": { "question": "Can I exchange my size?", "answer": "<p>Yes — within 14 days, unworn with tags.</p>" } }, { "type": "question", "settings": { "question": "Do you accept cash on delivery?", "answer": "<p>Yes, everywhere in Egypt.</p>" } } ] } ]
}
{% endschema %}
