{%- assign s = section.settings -%}
<section class="section wrap" id="s-{{ section.id }}">
  <div class="section-head">
    <div class="section-head__text" data-reveal>
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{% if s.number != blank %}<span class="eyebrow__num">{{ s.number }}</span>{% endif %}{{ s.eyebrow }}</p>{%- endif -%}
      <h2>{{ s.heading }}</h2>
    </div>
    {%- if s.rating_text != blank -%}<p class="chip" data-reveal>{% render 'icon', name: 'star', px: 14 %} {{ s.rating_text }}</p>{%- endif -%}
  </div>
  <div class="reviews">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <blockquote class="review glass glass--hover" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <div class="review__stars" aria-label="{{ b.rating }}/5">{%- for i in (1..5) -%}{%- if i <= b.rating -%}{% render 'icon', name: 'star', px: 16 %}{%- endif -%}{%- endfor -%}</div>
        <p class="review__quote">“{{ b.quote }}”</p>
        <footer class="review__who">
          <span class="review__avatar">{{ b.name | slice: 0 }}</span>
          <span><strong>{{ b.name }}</strong>{% if b.meta != blank %} · {{ b.meta }}{% endif %}</span>
          <span class="review__verified">{% render 'icon', name: 'check', px: 12 %}{{ 'sections.reviews.verified' | t }}</span>
        </footer>
      </blockquote>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "number", "label": "Section number", "default": "05" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn & rated" },
    { "type": "text", "id": "rating_text", "label": "Rating chip", "default": "4.9 / 5 · 300+ orders" }
  ],
  "blocks": [ { "type": "quote", "name": "Quote", "settings": [
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Heaviest hoodie I own and the embroidery is unreal." },
    { "type": "text", "id": "name", "label": "Name", "default": "Omar K." },
    { "type": "text", "id": "meta", "label": "Meta", "default": "Cairo" },
    { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 }
  ] } ],
  "presets": [ { "name": "Testimonials", "blocks": [ { "type": "quote" }, { "type": "quote", "settings": { "quote": "Exchange was painless and the fit guide was spot on.", "name": "Salma A.", "meta": "Alexandria" } }, { "type": "quote", "settings": { "quote": "The penguin sticker alone is worth it. Site looks insane too.", "name": "Youssef M.", "meta": "Giza" } } ] } ]
}
{% endschema %}
