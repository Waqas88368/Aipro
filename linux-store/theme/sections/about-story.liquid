{%- assign s = section.settings -%}
<section class="page wrap">
  <div class="about-hero glass" data-reveal>
    <div class="media media__zoom">
      {%- if s.image != blank -%}<img src="{{ s.image | image_url: width: 1200 }}" alt="{{ s.image.alt | escape }}" width="{{ s.image.width }}" height="{{ s.image.height }}" loading="eager">{%- else -%}<img src="{{ 'brand-editorial.webp' | asset_url }}" alt="" width="1400" height="788" loading="eager">{%- endif -%}
    </div>
    <div style="display:grid;gap:16px">
      <p class="eyebrow">{{ s.eyebrow }}</p>
      <h1 class="display" style="font-size:clamp(34px,4.6vw,66px)">{{ s.heading | default: page.title }}</h1>
      <div class="rte">{{ s.intro | default: page.content }}</div>
    </div>
  </div>
  <div class="about-stats">
    {%- for block in section.blocks -%}
      {%- if block.type == 'stat' -%}
        <div class="about-stat glass" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="timeline">
    {%- for block in section.blocks -%}
      {%- if block.type == 'moment' -%}
        <div class="timeline__item glass" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}><span class="mono">{{ block.settings.year }}</span><div><strong>{{ block.settings.title }}</strong><p class="muted small" style="margin-top:4px">{{ block.settings.text }}</p></div></div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "About story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thread over trend." },
    { "type": "richtext", "id": "intro", "label": "Intro" }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "settings": [ { "type": "text", "id": "value", "label": "Value", "default": "4,000" }, { "type": "text", "id": "label", "label": "Label", "default": "stitches per minute" } ] },
    { "type": "moment", "name": "Timeline moment", "settings": [ { "type": "text", "id": "year", "label": "Year", "default": "2024" }, { "type": "text", "id": "title", "label": "Title", "default": "The first hoodie" }, { "type": "text", "id": "text", "label": "Text", "default": "Stitched on a borrowed machine in Nasr City." } ] }
  ]
}
{% endschema %}
