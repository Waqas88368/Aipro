{%- comment -%}
  Customize studio. The merchant picks the "Customize" product (its variants
  carry colour/size/type and the real price). The shopper uploads artwork,
  positions it live on a garment, and the design + placement are attached as
  line-item properties. The upload itself is a Shopify file input on the
  product form, so it reaches the order as a file property.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = s.product
  if p == blank
    assign p = all_products['hoodie-customize']
  endif
  if p == blank
    assign p = collections.all.products.first
  endif
  assign current = p.selected_or_first_available_variant
-%}
<section class="cz wrap" data-customize data-product data-product-handle="{{ p.handle }}">
  <header class="cz__head" data-reveal>
    <p class="eyebrow">{% render 'tr', value: s.eyebrow, key: 'home.customize_eyebrow' %}</p>
    <h1 class="display" style="font-size:clamp(36px,5vw,72px)">{% render 'tr', value: s.heading, key: 'home.customize_heading' %}</h1>
    <p class="lede">{%- assign t_sub = 'customize.subtitle' | t -%}{{ s.subheading | default: t_sub }}</p>
  </header>

  <div class="cz__grid">
    <div class="cz__stage glass" data-specular data-reveal>
      <div class="cz__canvas" data-cz-canvas>
        {%- assign first_hex = s.colors | default: 'Forest:#043020,Black:#111111,Cream:#f5f5f0,Beige:#e6d5b8,Burgundy:#6b1e2b,Navy:#1b2a4a' | split: ',' | first | split: ':' | last | strip -%}
        <div class="cz__garment" data-cz-garment style="--gc: {{ first_hex }}">
          <svg viewBox="0 0 400 460" data-cz-svg aria-hidden="true">
            <g data-cz-shape="tee"><path d="M120 40 L60 80 L20 160 L80 195 L95 165 L95 430 L305 430 L305 165 L320 195 L380 160 L340 80 L280 40 Q240 75 200 75 Q160 75 120 40 Z" fill="var(--gc)" stroke="rgb(255 255 255 / .12)" stroke-width="2"/><path d="M120 40 Q160 75 200 75 Q240 75 280 40" fill="none" stroke="rgb(0 0 0 / .25)" stroke-width="6"/></g>
            <g data-cz-shape="hoodie" style="display:none"><path d="M120 55 L55 95 L18 175 L80 208 L95 178 L95 430 L305 430 L305 178 L320 208 L382 175 L345 95 L280 55 Q276 20 200 20 Q124 20 120 55 Z" fill="var(--gc)" stroke="rgb(255 255 255 / .12)" stroke-width="2"/><path d="M150 60 Q200 105 250 60 Q235 92 200 92 Q165 92 150 60 Z" fill="rgb(0 0 0 / .35)"/><path d="M160 430 L160 360 Q200 345 240 360 L240 430" fill="none" stroke="rgb(0 0 0 / .2)" stroke-width="3"/><path d="M186 100 L182 150 M214 100 L218 150" stroke="rgb(255 255 255 / .35)" stroke-width="4" stroke-linecap="round"/></g>
            <g data-cz-shape="cap" style="display:none"><path d="M70 250 Q70 120 200 120 Q330 120 330 250 Z" fill="var(--gc)" stroke="rgb(255 255 255 / .12)" stroke-width="2"/><path d="M60 250 Q200 290 340 250 L380 265 Q200 330 20 265 Z" fill="var(--gc)" stroke="rgb(0 0 0 / .25)" stroke-width="2"/><path d="M200 120 L200 250" stroke="rgb(0 0 0 / .18)" stroke-width="2"/></g>
          </svg>
          <button class="cz__empty" type="button" data-cz-pick>{% render 'icon', name: 'upload', px: 22 %}<br>{{ 'customize.upload' | t }}</button>
          <div class="cz__design" data-cz-design hidden><img alt="{{ 'customize.preview_alt' | t }}" width="400" height="400" data-cz-design-img></div>
        </div>
      </div>
      <div class="segmented cz__side-toggle" role="radiogroup" aria-label="{{ 'customize.side' | t }}">
        <button class="segmented__btn is-active" type="button" data-cz-side="front" aria-pressed="true">{{ 'customize.front' | t }}</button>
        <button class="segmented__btn" type="button" data-cz-side="back" aria-pressed="false">{{ 'customize.back' | t }}</button>
      </div>
      <p class="cz__hint">{{ 'customize.hint_3d' | t }}</p>
    </div>

    {%- form 'product', p, class: 'cz__panel glass', data-product-form: '', data-cz-form: '' -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
      <input type="hidden" name="properties[_Design position]" data-cz-pos value="x:50,y:42,scale:45,side:front">
      <input type="hidden" name="properties[Garment]" data-cz-garment-prop value="tee">
      {%- assign first_color = s.colors | default: 'Forest:#043020,Black:#111111,Cream:#f5f5f0,Beige:#e6d5b8,Burgundy:#6b1e2b,Navy:#1b2a4a' | split: ',' | first | split: ':' | first | strip -%}
      <input type="hidden" name="properties[Colour]" data-cz-color-prop value="{{ first_color | escape }}">

      <div class="cz__step">
        <p class="cz__step-title"><span class="badge">1</span>{{ 'customize.upload' | t }}</p>
        <label class="cz__drop" data-cz-drop>
          {% render 'icon', name: 'upload', px: 28 %}
          <strong>{{ 'customize.upload' | t }}</strong>
          <small>{{ 'customize.upload_hint' | t }}</small>
          <input type="file" name="properties[Design file]" accept="image/png,image/jpeg,image/svg+xml,image/webp" class="visually-hidden" data-cz-file>
        </label>
        <div class="cz__file glass glass--clear" data-cz-file-row hidden>
          <img alt="" width="48" height="48" data-cz-thumb><div><strong data-cz-filename></strong><small class="muted" data-cz-filesize></small></div>
          <button class="btn btn--ghost btn--sm" type="button" data-cz-remove>{{ 'customize.remove' | t }}</button>
        </div>
        <p class="form-error" data-cz-error hidden></p>
      </div>

      <div class="cz__step">
        <p class="cz__step-title"><span class="badge">2</span>{{ 'customize.garment' | t }} · {{ 'customize.color' | t }}</p>
        <div class="cz__garments">
          {%- for block in section.blocks -%}
            {%- if block.type == 'garment' -%}{%- assign g_key0 = 'home.garment_' | append: block.settings.shape -%}
              <button class="cz__garment-opt{% if forloop.first %} is-active{% endif %}" type="button" data-cz-garment-opt="{{ block.settings.shape }}" data-fee="{{ block.settings.fee | default: 0 | times: 100 }}" {%- capture g_label -%}{% render 'tr', value: block.settings.label, key: g_key0 %}{%- endcapture -%}data-label="{{ g_label | strip | escape }}" {{ block.shopify_attributes }}>
                <svg viewBox="0 0 400 460" aria-hidden="true">
                  {%- case block.settings.shape -%}
                    {%- when 'hoodie' -%}<path d="M120 55 L55 95 L18 175 L80 208 L95 178 L95 430 L305 430 L305 178 L320 208 L382 175 L345 95 L280 55 Q276 20 200 20 Q124 20 120 55 Z" fill="currentColor"/>
                    {%- when 'cap' -%}<path d="M70 250 Q70 120 200 120 Q330 120 330 250 Z M60 250 Q200 290 340 250 L380 265 Q200 330 20 265 Z" fill="currentColor"/>
                    {%- else -%}<path d="M120 40 L60 80 L20 160 L80 195 L95 165 L95 430 L305 430 L305 165 L320 195 L380 160 L340 80 L280 40 Q240 75 200 75 Q160 75 120 40 Z" fill="currentColor"/>
                  {%- endcase -%}
                </svg>
                {%- assign g_key = 'home.garment_' | append: block.settings.shape -%}<strong>{% render 'tr', value: block.settings.label, key: g_key %}</strong>
                <span>{% if block.settings.fee > 0 %}+{{ block.settings.fee | times: 100 | money }}{% else %}—{% endif %}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="cz__colors" role="radiogroup" aria-label="{{ 'customize.color' | t }}">
          {%- assign colors = s.colors | default: 'Forest:#043020,Black:#111111,Cream:#f5f5f0,Beige:#e6d5b8,Burgundy:#6b1e2b,Navy:#1b2a4a' | split: ',' -%}
          {%- for c in colors -%}
            {%- liquid
              assign parts = c | strip | split: ':'
              if parts.size > 1
                assign c_name = parts[0] | strip
                assign c_hex = parts[1] | strip
              else
                assign c_name = parts[0] | strip
                assign c_hex = parts[0] | strip
              endif
            -%}
            <button class="pill swatch{% if forloop.first %} is-active{% endif %}" type="button" style="--swatch: {{ c_hex }}" data-cz-color="{{ c_hex }}" data-cz-color-name="{{ c_name | escape }}" aria-label="{{ c_name | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" title="{{ c_name | escape }}"></button>
          {%- endfor -%}
        </div>
      </div>

      {%- unless p.has_only_default_variant -%}
        <div class="cz__step">
          <p class="cz__step-title"><span class="badge">3</span>{{ 'customize.size' | t }}</p>
          {%- for option in p.options_with_values -%}
            <fieldset class="pdp__option" data-option-index="{{ forloop.index0 }}">
              <legend class="pdp__option-label"><span>{% render 'option-name', name: option.name %}</span><strong data-option-value="{{ forloop.index0 }}">{% render 'option-value', value: option.selected_value %}</strong></legend>
              <div class="pills">
                {%- for value in option.values -%}
                  <label class="pill"><input type="radio" name="option{{ option.position }}" value="{{ value | escape }}" data-option-input="{{ option.position | minus: 1 }}" {% if option.selected_value == value %}checked{% endif %}>{{ value }}</label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      <div class="cz__step">
        <p class="cz__step-title"><span class="badge">4</span>{{ 'customize.position' | t }}</p>
        <label class="field"><span class="field__label">{{ 'customize.scale' | t }}</span><input class="cz__range" type="range" min="15" max="70" value="45" data-cz-scale></label>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="btn btn--ghost btn--sm" type="button" data-cz-reset>{% render 'icon', name: 'rotate', px: 14 %}{{ 'customize.reset' | t }}</button>
        </div>
        <label class="field"><span class="field__label">{{ 'customize.notes' | t }}</span><textarea class="textarea" name="properties[Notes]" rows="2" placeholder="{{ 'customize.notes_placeholder' | t }}" style="min-height:80px"></textarea></label>
      </div>

      <div class="cz__total">
        <div><small>{{ 'customize.total' | t }}</small><br><strong data-cz-total>{{ current.price | money }}</strong></div>
        <div class="pdp__stock" data-stock><span class="dot"></span>{{ 'customize.step_4' | t }}</div>
      </div>
      <button class="btn btn--primary btn--lg btn--block" type="submit" data-atc data-cz-submit><span data-atc-text>{{ 'customize.add' | t }}</span><span class="pdp__atc-price" data-atc-price>{{ current.price | money }}</span></button>
      <p class="form-error" data-cz-submit-error hidden></p>
    {%- endform -%}
  </div>

  <div class="cz__steps">
    <div class="prop glass" data-reveal><span class="prop__icon">{% render 'icon', name: 'upload', px: 20 %}</span><strong>{{ 'customize.step_1' | t }}</strong></div>
    <div class="prop glass" data-reveal style="--i:1"><span class="prop__icon">{% render 'icon', name: 'tag', px: 20 %}</span><strong>{{ 'customize.step_2' | t }}</strong></div>
    <div class="prop glass" data-reveal style="--i:2"><span class="prop__icon">{% render 'icon', name: 'sparkle', px: 20 %}</span><strong>{{ 'customize.step_3' | t }}</strong></div>
    <div class="prop glass" data-reveal style="--i:3"><span class="prop__icon">{% render 'icon', name: 'needle', px: 20 %}</span><strong>{{ 'customize.step_4' | t }}</strong></div>
  </div>

  <script type="application/json" data-option-labels>{ {%- for option in p.options_with_values -%}{%- for value in option.values -%}{%- capture lv -%}{% render 'option-value', value: value %}{%- endcapture -%}{{ value | json }}: {{ lv | strip | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }</script>
  <script type="application/json" data-variants>{{ p.variants | json }}</script>
  <script type="application/json" data-product-json>{"id":{{ p.id }},"handle":{{ p.handle | json }},"title":{{ p.title | json }},"url":{{ p.url | json }},"price":{{ p.price }},"lowStock":{{ settings.low_stock | default: 5 }},"strings":{"lowStock":{{ 'products.low_stock' | t: count: '[count]' | json }},"inStock":{{ 'customize.step_4' | t | json }},"soldOut":{{ 'products.sold_out' | t | json }},"unavailable":{{ 'products.unavailable' | t | json }},"addToBag":{{ 'customize.add' | t | json }},"needDesign":{{ 'customize.need_design' | t | json }},"fileTooBig":{{ 'customize.file_too_big' | t | json }},"fileType":{{ 'customize.file_type' | t | json }}}}</script>
</section>
{% schema %}
{
  "name": "Customize studio",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Customize product (variants carry size/colour/price)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "colors",
      "label": "Garment colours (Name:#hex, comma-separated)",
      "default": "Forest:#043020,Black:#111111,Cream:#f5f5f0,Beige:#e6d5b8,Burgundy:#6b1e2b,Navy:#1b2a4a"
    }
  ],
  "blocks": [
    {
      "type": "garment",
      "name": "Garment",
      "settings": [
        {
          "type": "select",
          "id": "shape",
          "label": "Shape",
          "options": [
            {
              "value": "tee",
              "label": "T-shirt"
            },
            {
              "value": "hoodie",
              "label": "Hoodie"
            },
            {
              "value": "cap",
              "label": "Cap"
            }
          ],
          "default": "tee"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "number",
          "id": "fee",
          "label": "Extra fee (LE, display only)",
          "default": 0
        }
      ]
    }
  ]
}
{% endschema %}
