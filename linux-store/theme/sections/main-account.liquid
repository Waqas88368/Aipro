<section class="account wrap">
  <header class="cart-page__head" data-reveal>
    <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
    <h1>{{ 'customer.account.welcome' | t: name: customer.first_name | default: customer.name }}</h1>
  </header>
  <div class="account__grid">
    {% render 'account-nav', active: 'orders' %}
    <div class="account__main">
      <div class="account__panel glass" data-reveal>
        <h2 class="h3">{{ 'customer.account.orders' | t }}</h2>
        {%- paginate customer.orders by 10 -%}
          {%- if customer.orders.size > 0 -%}
            <div style="display:grid;gap:10px">
              {%- for order in customer.orders -%}
                <a href="{{ order.customer_url }}" class="order-row glass glass--clear glass--hover">
                  <div>
                    <strong>{{ order.name }}</strong>
                    <div class="order-row__meta"><span>{{ order.created_at | date: format: 'month_day_year' }}</span><span class="status status--{{ order.financial_status }}">{{ order.financial_status_label }}</span><span class="status status--{{ order.fulfillment_status }}">{{ order.fulfillment_status_label }}</span></div>
                  </div>
                  <strong class="mono">{{ order.total_price | money }}</strong>
                </a>
              {%- endfor -%}
            </div>
            {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
          {%- else -%}
            <div class="empty-state" style="padding:24px">{% render 'mascot', name: 'classic', width: 110 %}<p class="muted">{{ 'customer.account.no_orders_body' | t }}</p><a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--sm">{{ 'cart.start_shopping' | t }}</a></div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
      <div class="account__panel glass" data-reveal style="--i:1">
        <h2 class="h3">{{ 'customer.account.details' | t }}</h2>
        <p>{{ customer.name }}<br><span class="muted">{{ customer.email }}</span></p>
        {%- if customer.default_address -%}<div class="address-card glass glass--clear"><strong>{{ 'customer.account.default_address' | t }}</strong>{{ customer.default_address | format_address }}</div>{%- endif -%}
        <a href="{{ routes.account_addresses_url }}" class="btn btn--ghost btn--sm" style="justify-self:start">{{ 'customer.account.view_addresses' | t }}</a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
