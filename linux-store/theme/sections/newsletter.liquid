{%- assign s = section.settings -%}
<section class="section wrap" id="s-{{ section.id }}">
  <div class="newsletter glass" data-specular data-reveal>
    <div>
      <p class="eyebrow">{% render 'tr', value: s.eyebrow, key: 'home.newsletter_eyebrow' %}</p>
      <h2>{% render 'tr', value: s.heading, key: 'home.newsletter_heading' %}</h2>
      <p class="lede" style="margin-top:10px">{% render 'tr', value: s.body, key: 'home.newsletter_body' %}</p>
    </div>
    {%- form 'customer', id: 'newsletter-section', class: 'newsletter__form glass glass--pill' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success" style="padding:12px 18px">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input class="input" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required aria-label="{{ 'newsletter.placeholder' | t }}">
        <button class="btn btn--primary" type="submit">{{ 'newsletter.button' | t }}{% render 'icon', name: 'arrow-right' %}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (blank = translated)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (blank = translated)"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Text (blank = translated)"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
