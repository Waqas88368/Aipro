{%- assign s = section.settings -%}
<section class="section wrap" id="s-{{ section.id }}">
  <div class="newsletter glass" data-specular data-reveal>
    <div>
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2>{{ s.heading }}</h2>
      {%- if s.body != blank -%}<p class="lede" style="margin-top:10px">{{ s.body }}</p>{%- endif -%}
    </div>
    {%- form 'customer', id: 'newsletter-section', class: 'newsletter__form glass glass--pill' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success" style="padding:12px 18px">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input class="input" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required aria-label="{{ 'newsletter.placeholder' | t }}">
        <button class="btn btn--primary" type="submit">{{ 'newsletter.button' | t }}{% render 'icon', name: 'arrow-right' %}</button>
      {%- endif -%}
    {%- endform -%}
    {%- if s.show_mascot -%}<div class="newsletter__mascot" aria-hidden="true">{% render 'mascot', name: 'astro', width: 120 %}</div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the flock" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Early access to every drop." },
    { "type": "textarea", "id": "body", "label": "Text", "default": "10% off your first order. No spam — just penguins." },
    { "type": "checkbox", "id": "show_mascot", "label": "Show penguin", "default": true }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
