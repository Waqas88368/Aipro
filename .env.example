# ── Telegram ──────────────────────────────────────────────────────────────
# Bot token from @BotFather. NEVER paste it into chat/issue tickets.
BOT_TOKEN=

# ── University portal (UnicodeSIS at su.edu.eg) ──────────────────────────
# Default is the live API origin discovered from the official SPA bundle.
PORTAL_BASE_URL=http://unicodesis.su.edu.eg:150/api/

# Optional pre-provisioned credentials (used when the user does NOT send
# email/password to the bot at runtime). If left empty, the bot asks each
# user for their @su.edu.eg email and password once; the password is used
# in memory for the login call and is NEVER stored or logged.
PORTAL_EMAIL=
PORTAL_PASSWORD=

# Polite throttling between portal API requests (ms) and transient retries.
PORTAL_THROTTLE_MS=900
PORTAL_MAX_RETRIES=3

# ── AI ranking/explanation (optional, OpenAI-compatible chat completions) ─
# Without a key the bot uses the deterministic fallback ranker.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── Moodle / K-Moodle (optional) ─────────────────────────────────────────
# REST web service endpoint and user token (Moodle: Preferences → tokens).
MOODLE_BASE_URL=
MOODLE_TOKEN=

# ── Reminders ────────────────────────────────────────────────────────────
REMINDER_INTERVAL_MS=3600000
REMINDER_HORIZON_DAYS=2

# ── Ops ──────────────────────────────────────────────────────────────────
DATA_DIR=./data
PORT=3000
